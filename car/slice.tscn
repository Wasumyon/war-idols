[sub_resource type="Shader" id="VigShader_1"]
code = "shader_type canvas_item;
uniform float intensity : hint_range(0.0, 1.0) = 0.3;
void fragment() {
	vec2 uv = UV - vec2(0.5);
	float d = length(uv);
	float v = smoothstep(0.15, 0.95, d) * intensity;
	COLOR = vec4(0.0, 0.0, 0.0, v);
}"

