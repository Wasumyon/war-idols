[ext_resource type="Script" uid="uid://dicdxrvgloxgw" path="res://vn/vn.gd" id="1_vn"]

[sub_resource type="Shader" id="GlitchShader_1"]
code = "shader_type canvas_item;
uniform sampler2D screen_tex : hint_screen_texture, filter_linear;
uniform float intensity : hint_range(0.0, 1.0) = 0.0;
float hash(float x) { return fract(sin(x * 91.7) * 43758.5453); }
void fragment() {
	vec2 uv = SCREEN_UV;
	float t = floor(TIME * 22.0);
	float band = floor(uv.y * 22.0);
	float n = hash(band * 1.37 + t);
	uv.x += step(0.7, n) * (hash(band + t * 2.1) - 0.5) * 0.15 * intensity;
	float s = 0.005 * intensity;
	float r = texture(screen_tex, uv + vec2(s, 0.0)).r;
	float g = texture(screen_tex, uv).g;
	float b = texture(screen_tex, uv - vec2(s, 0.0)).b;
	vec3 col = vec3(r, g, b);
	col *= 1.0 - 0.3 * intensity * step(0.5, fract(uv.y * 160.0));
	COLOR = vec4(col, intensity);
}"

